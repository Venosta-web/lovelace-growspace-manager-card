# Home Assistant Configuration
HA_BASE_URL=http://localhost:8123
HA_ACCESS_TOKEN=your_long_lived_access_token_here
# Optional when HA registers the card at a non-workspace URL:
# E2E_CARD_URL=/local/community/lovelace-growspace-manager-card/growspace-manager-card.js

# Legacy single-growspace config (used by smoke/setup/insights/plant-actions specs).
# This path is owned by scripts/gen-e2e-dashboards.cjs in the workspace hub.
TEST_DASHBOARD_PATH=/e2e-veg/0
TEST_GROWSPACE_ID=your_test_growspace_id_here

# Stage-specific e2e growspace IDs — auto-written by fixtures/e2e-setup.ts
# Stage-specific dashboard paths — set manually to match your HA dashboard URLs
TEST_VEG_GROWSPACE_ID=99abd089-c2ff-4d34-a25c-5e4e34d31e73
TEST_VEG_DASHBOARD_PATH=http://localhost:8123/e2e-veg/0
# plant_id of the anchor plant in the veg growspace (row 1, col 1) — used by plant-watering-round-trip.spec.ts
TEST_VEG_PLANT_ID=your_veg_plant_id_here

TEST_CLONE_GROWSPACE_ID=de46b60c-04fe-4b56-8441-0fb721b47cb4
TEST_CLONE_DASHBOARD_PATH=http://localhost:8123/e2e-clone/0

TEST_MOTHER_GROWSPACE_ID=9f8b2fe3-276c-41f6-9f94-58071d58f2bf
TEST_MOTHER_DASHBOARD_PATH=http://localhost:8123/e2e-mother/0

TEST_FLOWER_GROWSPACE_ID=8fec501b-e7ea-47ff-a49f-d9f394eb214d
TEST_FLOWER_DASHBOARD_PATH=http://localhost:8123/e2e-flower/0

TEST_DRY_GROWSPACE_ID=f5151828-93af-4e29-bf41-7f160381d9b2
TEST_DRY_DASHBOARD_PATH=http://localhost:8123/e2e-dry/0

TEST_CURE_GROWSPACE_ID=93b89db2-8b59-436e-81e7-65ba93a2cb4c
TEST_CURE_DASHBOARD_PATH=http://localhost:8123/e2e-cure/0

# VWC growspace IDs — auto-written by fixtures/e2e-setup.ts after a successful run
# Dashboard paths — set manually to match your HA dashboard URLs
TEST_VWC_VEG_GROWSPACE_ID=
TEST_VWC_VEG_DASHBOARD_PATH=

TEST_VWC_FLOWER_GROWSPACE_ID=
TEST_VWC_FLOWER_DASHBOARD_PATH=

# Dedicated irrigation hardware profiles — auto-written by fixtures/e2e-setup.ts
TEST_IRRIGATION_MONITORED_GROWSPACE_ID=
TEST_IRRIGATION_TANKS_GROWSPACE_ID=

# Multi-sensor environmental telemetry profile — ID auto-written by
# fixtures/e2e-setup.ts; the dashboard is created by the workspace hub's
# scripts/gen-e2e-dashboards.cjs and defaults to /e2e-telemetry-multi/0.
TEST_TELEMETRY_MULTI_GROWSPACE_ID=
TEST_TELEMETRY_MULTI_DASHBOARD_PATH=

# Dedicated light-cycle and grow-light profile — auto-written by fixtures/e2e-setup.ts
TEST_LIGHTING_GROWSPACE_ID=

# Plain Home Assistant climate-actuator profile — ID auto-written by setup;
# dashboard created by the workspace hub's scripts/gen-e2e-dashboards.cjs.
TEST_CLIMATE_PLAIN_GROWSPACE_ID=
TEST_CLIMATE_PLAIN_DASHBOARD_PATH=http://localhost:8123/e2e-climate-plain/0

# Faithful AC Infinity port profile — ID auto-written by setup; dashboard is
# created by the workspace hub's dashboard generator.
TEST_AC_INFINITY_GROWSPACE_ID=
TEST_AC_INFINITY_DASHBOARD_PATH=http://localhost:8123/e2e-ac-infinity/0

# Dedicated camera and Vision Checkup profile — auto-written by fixtures/e2e-setup.ts
TEST_VISION_GROWSPACE_ID=
TEST_VISION_DASHBOARD_PATH=http://localhost:8123/e2e-vision/0
