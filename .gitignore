# Node modules.
# No trailing slash: that form matches directories only, so the node_modules
# *symlink* that `scripts/feature` creates in a worktree stayed untracked-but-
# visible, leaving every worktree permanently dirty and one `git add -A` away
# from committing the link. Bare `node_modules` matches a directory or a
# symlink, and still matches at any depth (tests/e2e/ installs its own).
node_modules

# Build output
build/

# Bundled card artifacts — produced by `npm run build`, served to HACS via
# GitHub Release assets (.releaserc.json), not from the repo tree. Untracked to
# keep the ~4MB minified bundle + 12MB sourcemap out of every diff. Manual
# installs download the asset from the latest release (see README).
/growspace-*.js
/dist/*.js
/dist/*.js.map

# Local env files
.env
tests/e2e/.env.test
ha-login-debug.png
ha-login-debug.html
ha-auth.json

# VSCode settings (optional)
.vscode/

# MacOS files
.DS_Store

# Ignore zip files
*.zip
growspace_manager/

# Ignore test results
test-results/
server.log

# Ignore test output
test_*.txt
test-*.txt
/.cache/

# Playwright
playwright-report/
coverage/tmp

# Logs and Debug output
*_log.txt
debug_output.txt

# Debug images
debug_*.png
verification_*.png

# Ignore coverage
coverage/


playwright/.auth/user.json
playwright-report/index.html
playwright-report/.auth/*

# Verification scratchpad
verification/
# Ignore test images (but keep visual snapshot baselines)
tests/**/*.png
!tests/**/__screenshots__/**/*.png

# Vitest runtime attachments (failure diffs, not baselines)
.vitest-attachments/

# E2E test reports
tests/e2e/test-reports/


# Git worktrees
.worktrees/
.claude/worktrees/

