.gemini/skills/
.github/agents/
.github/hooks/
.github/skills/


playwright-report-mock/index.html
.gitignore
test-results-mock/.last-run.json
coverage.txt
test_run.log
.sandcastle/*

# Demo site assembled by .github/workflows/demo.yaml
/_site/
