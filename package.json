{
  "name": "lovelace-growspace-manager-card",
  "version": "1.1.8",
  "description": "",
  "main": "rollup.config.js",
  "scripts": {
    "build": "rollup -c && cp dist/*.js .",
    "validate:hacs-release": "node scripts/validate-hacs-release.mjs",
    "copy:ha": "mkdir -p ../../config/www/ && cp dist/*.js ../../config/www/",
    "build:dev": "npm run build && npm run copy:ha",
    "watch": "rollup -c -w",
    "build:coverage": "COVERAGE=true rollup -c",
    "test": "npm run test:unit",
    "test:contract-fixture": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "npm run build && npm run test:ha",
    "test:ha": "npm --prefix tests/e2e run test",
    "test:ha:headed": "npm --prefix tests/e2e run test:headed",
    "test:ha:debug": "npm --prefix tests/e2e run test:debug",
    "test:unit": "npm run test:tooling && node scripts/run-browser-tests.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:unit:watch": "vitest",
    "test:coverage": "node scripts/run-browser-tests.mjs --coverage",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,js,json,css,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json,css,md}'",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "tokens:audit": "node scripts/audit-design-tokens.mjs"
  },
  "keywords": [],
  "author": "Venosta-web",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7",
    "@eslint/js": "^9.39.4",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@lit-labs/testing": "^0.2.8",
    "@open-wc/testing-helpers": "^3.0.1",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "c8": "^10.1.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^15.15.0",
    "home-assistant-js-websocket": "^9.6.0",
    "lit": "^3.3.3",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "rollup": "^4.61.1",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-summary": "^3.0.1",
    "semantic-release": "^25.0.3",
    "source-map-support": "^0.5.21",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@lit/reactive-element": "^2.1.2",
    "@mdi/js": "^7.4.47",
    "@nanostores/lit": "^0.2.3",
    "@types/three": "^0.184.1",
    "custom-card-helpers": "^2.0.0",
    "luxon": "^3.7.2",
    "nanostores": "^1.3.0",
    "qrcode-generator": "^2.0.4",
    "three": "^0.184.0",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  }
}
