{
  "name": "lovelace-growspace-manager-card",
  "version": "1.3.1",
  "description": "",
  "main": "rollup.config.js",
  "scripts": {
    "build": "rollup -c && cp dist/*.js .",
    "build:release": "NODE_ENV=production npm run build",
    "validate:hacs-release": "node scripts/validate-hacs-release.mjs",
    "budget:bundle": "node scripts/check-bundle-budget.mjs",
    "publishing:verify": "node scripts/run-publishing.mjs verify",
    "publishing:publish": "node scripts/run-publishing.mjs publish",
    "copy:ha": "mkdir -p ../../config/www/ && cp dist/*.js ../../config/www/",
    "build:dev": "npm run build && npm run copy:ha",
    "watch": "rollup -c -w",
    "build:coverage": "COVERAGE=true rollup -c",
    "test": "npm run --silent test:e2e-runtime-harness && node scripts/run-browser-tests.mjs",
    "test:contract-fixture": "vitest run --config vitest.contract.config.ts",
    "test:ci-policy": "node --test scripts/ci-release-policy.test.mjs scripts/entry-bundle-shape.test.mjs scripts/lazy-chunk-entry-binding.test.mjs scripts/fetch-contract-fixtures.test.mjs scripts/publishing.test.mjs scripts/release-minification.test.mjs scripts/bundle-budget.test.mjs scripts/release-window.test.mjs scripts/dependency-audit.test.mjs",
    "audit:ci": "node scripts/check-dependency-audit.mjs",
    "test:e2e-runtime-harness": "node --test scripts/e2e-build-state.test.mjs scripts/e2e-runtime-harness.test.mjs tests/e2e/global-setup.test.mjs",
    "test:e2e": "node scripts/run-e2e-runtime-harness.mjs managed",
    "test:ha": "node scripts/run-e2e-runtime-harness.mjs attached",
    "test:ha:headed": "node scripts/run-e2e-runtime-harness.mjs attached --headed",
    "test:ha:debug": "node scripts/run-e2e-runtime-harness.mjs attached --debug",
    "test:unit": "npm run --silent test:e2e-runtime-harness && node scripts/run-browser-tests.mjs",
    "test:unit:watch": "vitest",
    "test:coverage": "node scripts/run-browser-tests.mjs --coverage",
    "lint": "eslint 'src/**/*.{ts,js}' && npm run --silent lint:unused",
    "lint:unused": "knip --production --files && knip --exports && knip --dependencies",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,js,json,css,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json,css,md}'",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "tokens:audit": "node scripts/audit-design-tokens.mjs"
  },
  "keywords": [],
  "author": "Venosta-web",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@open-wc/testing-helpers": "^3.0.1",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.10.4",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^15.15.0",
    "home-assistant-js-websocket": "^9.6.0",
    "knip": "^6.38.0",
    "lit": "^3.3.3",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "rollup": "^4.61.1",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-summary": "^3.0.1",
    "semantic-release": "^25.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@mdi/js": "^7.4.47",
    "@nanostores/lit": "^0.2.3",
    "custom-card-helpers": "^2.0.0",
    "nanostores": "^1.3.0",
    "qrcode-generator": "^2.0.4",
    "three": "^0.184.0",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  }
}
